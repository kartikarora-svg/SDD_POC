# Application Settings
APP_NAME=Finalytics MVP
DEBUG=false

# Database Configuration
# SQLite (default - no Docker/server needed):
DATABASE_URL=sqlite:///./finalytics.db

# PostgreSQL (production-ready, supports concurrent writes):
# DATABASE_URL=postgresql://finalytics_user:your_password@localhost:5432/finalytics

# MySQL/MariaDB (alternative option):
# DATABASE_URL=mysql+pymysql://finalytics_user:your_password@localhost:3306/finalytics

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Secret (generate a random 256-bit key)
JWT_SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Groq API Key (for LLM)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=your-email@gmail.com

# File Storage
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE=52428800

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./chroma_data

# Tesseract OCR (optional, only if not in PATH)
# TESSERACT_CMD=/usr/bin/tesseract

# News Scraping
NEWS_SCRAPE_INTERVAL_MINUTES=5
NEWS_CACHE_TTL_SECONDS=3600

